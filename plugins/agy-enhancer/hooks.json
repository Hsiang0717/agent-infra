{
  "agy-enhancer": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "bin\\agy-enhancer.exe",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "bin\\agy-enhancer.exe --pre-edit",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
