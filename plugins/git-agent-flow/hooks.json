{
  "git-agent-flow-hook": {
    "enabled": true,
    "PostInvocation": [
      {
        "type": "command",
        "command": "pwsh -NoProfile -File ./scripts/git_on_stop.ps1",
        "timeout": 15
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "pwsh -NoProfile -File ./scripts/git_on_stop.ps1",
        "timeout": 15
      }
    ]
  }
}