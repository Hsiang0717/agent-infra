{
  "agy-context-flow-hooks": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./bin/context-flow.cjs hook pre-invocation",
        "timeout": 5
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "node ./bin/context-flow.cjs hook post-invocation",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./bin/context-flow.cjs hook stop",
        "timeout": 10
      }
    ]
  }
}
