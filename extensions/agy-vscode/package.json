{
  "name": "agy-vscode",
  "displayName": "AGY CLI",
  "description": "Quickly open AGY CLI in a native terminal.",
  "version": "0.0.5",
  "publisher": "Hsiang0717",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hsiang0717/skill-development"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:agy.start"
  ],
  "contributes": {
    "commands": [
      {
        "command": "agy.start",
        "title": "Open AGY CLI",
        "icon": "resources/icon.svg"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "agy.start",
          "group": "navigation",
          "when": "true"
        }
      ]
    },
    "configuration": {
      "title": "AGY CLI",
      "properties": {
        "agy.terminalLocation": {
          "type": "string",
          "enum": [
            "editor",
            "panel"
          ],
          "default": "editor",
          "description": "Location where the AGY CLI terminal should be opened ('editor' or 'panel')."
        },
        "agy.reuseTerminal": {
          "type": "boolean",
          "default": false,
          "description": "Reuse the existing AGY CLI terminal if it is already open instead of creating a new one."
        },
        "agy.customPath": {
          "type": "string",
          "default": "",
          "description": "Custom path or executable name for AGY CLI (defaults to 'agy')."
        },
        "agy.customArguments": {
          "type": "string",
          "default": "",
          "description": "Extra arguments passed to AGY CLI on startup."
        },
        "agy.venvPath": {
          "type": "string",
          "default": "",
          "description": "Custom virtual environment path. If empty, automatically detects '.venv' in workspace root."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package",
    "install-extension": "code --install-extension *.vsix --force"
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/vscode": "^1.70.0",
    "@vscode/vsce": "^3.9.1",
    "typescript": "^4.7.4"
  }
}